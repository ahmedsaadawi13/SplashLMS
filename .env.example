# FILE: /.env.example
# SplashLMS Environment Configuration
# Copy this file to .env and update with your actual values

# Application
APP_NAME=SplashLMS
APP_ENV=development
APP_URL=http://localhost
APP_TIMEZONE=UTC

# Database
DB_HOST=localhost
DB_NAME=splashlms
DB_USER=root
DB_PASS=

# Session
SESSION_LIFETIME=7200

# File Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,ppt,pptx,zip

# Email (for future SMTP integration)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@splashlms.com
MAIL_FROM_NAME=SplashLMS

# Security
CSRF_TOKEN_NAME=csrf_token
PASSWORD_MIN_LENGTH=8

# Pagination
ITEMS_PER_PAGE=20

# API
API_RATE_LIMIT=100
